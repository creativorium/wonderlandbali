{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wonderland/hero",
	"title": "Wonderland Hero",
	"category": "wonderland",
	"icon": "cover-image",
	"description": "Full-screen hero banner with vertical label, headline, subheadline, ghost CTA and an award badge — matches the Wonderland Bali homepage.",
	"keywords": [ "hero", "banner", "cover", "wonderland" ],
	"textdomain": "wonderland-blocks",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ]
	},
	"attributes": {
		"slides": { "type": "array", "default": [] },
		"slideDuration": { "type": "number", "default": 4000 },
		"kenBurns": { "type": "boolean", "default": true },
		"backgroundId": { "type": "number" },
		"backgroundUrl": { "type": "string", "default": "" },
		"overlayOpacity": { "type": "number", "default": 40 },
		"sideText": {
			"type": "string",
			"default": "WEDDING PLANNING & STYLING   |   EVENT PLANNING & STYLING"
		},
		"sideLinks": {
			"type": "array",
			"default": [
				{ "text": "Wedding Planning & Styling", "url": "/weddings-planning-styling/" },
				{ "text": "Event Planning & Styling", "url": "/events-planning-styling/" }
			]
		},
		"heading": {
			"type": "string",
			"default": "\"OH WOW\" WEDDING PLANNING & STYLING"
		},
		"subheading": {
			"type": "string",
			"default": "Creating wonders in Bali, Portugal and Italy."
		},
		"buttonText": { "type": "string", "default": "MAKE A REQUEST" },
		"buttonUrl": { "type": "string", "default": "#" },
		"badgeId": { "type": "number" },
		"badgeUrl": { "type": "string", "default": "" }
	},
	"render": "file:./render.php"
}
