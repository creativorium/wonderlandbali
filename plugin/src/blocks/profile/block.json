{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wonderland/profile",
	"title": "Wonderland Profile",
	"category": "wonderland",
	"icon": "admin-users",
	"description": "Team profile: circular photo + big coral name + bio (reversible).",
	"keywords": [ "profile", "team", "bio", "wonderland" ],
	"textdomain": "wonderland-blocks",
	"supports": { "html": false, "anchor": true, "align": [ "full" ] },
	"attributes": {
		"name": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"imageId": { "type": "number" },
		"imageUrl": { "type": "string", "default": "" },
		"imagePosition": { "type": "string", "default": "left" }
	},
	"render": "file:./render.php"
}
